# ============================================================
# SKILLOR FULL-STACK ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ============================================================
# This file provides a reference template for all environment variables
# required for local development and for production deployment on
# Render (Backend) and Vercel (Frontend).
#
# DO NOT COMMIT ACTUAL .env FILES TO GIT.
# ============================================================

# ------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (backend/.env or Render Web Service)
# ------------------------------------------------------------
# PORT: The port the Express backend listens on.
# In local development: 5001
# On Render: Render provides PORT automatically (default: 10000)
PORT=5001

# NODE_ENV: development | production
NODE_ENV=development

# JWT_SECRET: Secret key for signing and verifying JWT authentication tokens.
# In production on Render: use a strong random 32+ character string.
JWT_SECRET=skillor_jwt_secret_dev_key_2026_change_in_production_super_secure

# JWT_EXPIRES_IN: Token expiration window (e.g., '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# CLIENT_URL: The URL of the frontend allowed for CORS requests.
# Local development: http://localhost:5173
# Production (Render): Set to your Vercel URL (e.g., https://skillor-n.vercel.app)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (frontend/.env or Vercel Project Settings)
# ------------------------------------------------------------
# VITE_API_URL: The base URL of the backend API.
# Local development (with Vite proxy): http://localhost:5001/api or /api
# Production (Vercel): Set to your Render backend URL with /api:
# VITE_API_URL=https://<your-render-service>.onrender.com/api
VITE_API_URL=http://localhost:5001/api
